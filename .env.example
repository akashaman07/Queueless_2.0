# API configuration. Use your own unique random secret (32+ characters).
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d
DEMO_DATA=true
# Optional. Creates the first admin only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000

# Local Docker Compose replica set is the default when this value is blank.
# For Atlas, paste the Node.js connection URI here. URL-encode special characters.
MONGO_URI=
MONGO_DB_NAME=queueless

# Browser app API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional Razorpay credentials. Use TEST keys for development; secrets stay backend-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RECEIPT_TTL_DAYS=30

# Optional product image storage. Secrets are used only by the backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
